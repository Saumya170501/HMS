rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    match /users/{userId} {
      // Allow users to read/write ONLY their own document
      allow read, write: if isOwner(userId);
      
      // Add validation to prevent storing too much data
      allow write: if isOwner(userId) 
                   && request.resource.size() < 500000; // 500KB limit per doc
      
      // Subcollections (portfolio-data, watchlist-data, etc.)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // NEW: Add a public read-only collection for shared data
    // (e.g., market stats, popular assets - optional)
    match /public/{document=**} {
      allow read: if true;
      allow write: if false; // Only backend can write
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
